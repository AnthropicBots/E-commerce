# Node modules
node_modules/

# Environment variables — never commit real secrets.
# Ignores .env and all variants in every directory, but keeps
# the placeholder template files (.env.example) tracked.
.env
.env.*
!.env.example

# System files
.DS_Store
Thumbs.db

# Logs
*.log 
# Jest coverage output — regenerated by every `npm test` run.
# Leaving it tracked made each test run show thousands of changed files.
coverage/
